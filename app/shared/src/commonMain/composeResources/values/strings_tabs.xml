    <string name="tab_charities">Charities</string>
    <string name="charities_title">Reputable charities nearby</string>
    <string name="charities_intro">Established organisations near the chosen city that help people in need. You give directly to them, on their own website.</string>
    <string name="charity_donate">Donate or help</string>
    <string name="charity_solidere_name">Solid-ère</string>
    <string name="charity_solidere_desc">A Lausanne association, active since 2020, that runs a free grocery shop at La Bourdonnette for more than 350 people a week. Food is given out without conditions, mostly by volunteers.</string>
    <string name="charity_cartons_name">Cartons du Cœur Lausanne</string>
    <string name="charity_cartons_desc">Free parcels of basic food for people in need. The organisation depends entirely on the solidarity and generosity of the public.</string>
    <string name="charity_cultive_name">Cultive toi</string>
    <string name="charity_cultive_desc">A Lausanne association, active since 2018, that fights food waste: it harvests unused fruit and vegetables, turns them into preserves in workshops and sells them to fund its work, combining ecology and social inclusion.</string>
    <string name="charities_radius">Within %1$d km of %2$s</string>
    <string name="charities_none">No charities listed within %1$d km of %2$s yet.</string>
    <string name="charity_centrepoint_name">Centrepoint</string>
    <string name="charity_centrepoint_desc">A charity for young people facing homelessness. It provides a safe place to stay, support and help towards education and work.</string>
    <string name="charity_londonyouth_name">London Youth</string>
    <string name="charity_londonyouth_desc">A registered charity that supports hundreds of youth clubs and community groups across London, so young people have safe places to learn, play and grow.</string>
    <string name="charity_kingstrust_name">The King's Trust</string>
    <string name="charity_kingstrust_desc">A registered youth charity that helps 11 to 30 year olds into education, training and work through free courses, mentoring and start-up support.</string>
    <string name="charity_magicbreakfast_name">Magic Breakfast</string>
    <string name="charity_magicbreakfast_desc">A registered charity that provides healthy breakfasts in schools, so hunger is not a barrier to learning for children.</string>
    <string name="charity_felix_name">The Felix Project</string>
    <string name="charity_felix_desc">A registered charity that rescues good surplus food and gives it for free to charities, schools and community groups across London, for people facing food poverty.</string>
    <string name="charities_criteria">Registered non-profits only: apolitical, with a focus on homelessness, youth, education and inclusion. No religious groups, businesses, alumni groups or personal benefit.</string>
